# The @dli scope resolves from the kaizen-pages-theme project's GitLab Package
# Registry (project id 357983 on gitlab-master.nvidia.com).
#
# Local dev: export NPM_TOKEN as a personal access token with the
# read_package_registry scope. In CI the job token is used instead (.gitlab-ci.yml
# rewrites this file with CI_JOB_TOKEN).
@dli:registry=https://gitlab-master.nvidia.com/api/v4/projects/357983/packages/npm/
//gitlab-master.nvidia.com/api/v4/projects/357983/packages/npm/:_authToken=${NPM_TOKEN}
